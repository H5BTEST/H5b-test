<div class="section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }} gradient stacked-slider">
  {% if section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
    <div class="page-width">
      <div class="main__title title-bottom-space {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %} {{ section.settings.main_title_alignment }}">
        {% if section.settings.main_subheading != blank %}<div class="sec_subheading">{{ section.settings.main_subheading }}</div>{% endif %}
        {% if section.settings.main_heading != blank %}<div class="sec_heading h2">{{ section.settings.main_heading }}</div>{% endif %}
        {% if section.settings.main_paragraph != blank %}<div class="sec_content">{{ section.settings.main_paragraph }}</div>{% endif %}
      </div>
    </div>
  {% endif %}
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <div class="vertical-slider-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}">
      <div class="vertical-slider">
        <div class="slider-items">
            <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
              {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
            </div>
          </div>
        {%- for block in section.blocks -%}
          <div class="slider-item {% unless forloop.first %}previous{% endunless %}" data-index="{{ forloop.index }}">
            {% if block.settings.image != blank %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
                {{ block.settings.image | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
              </div>
              {% else %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
                {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      
      <div class="stacked-slider-content  color-{{ section.settings.content_color_scheme }}">
        {%- for block in section.blocks -%}
          <div class="slide-content {% if forloop.first %}active-slide{% endif %}" data-index="{{ forloop.index }}">
            {% if block.settings.heading != blank %}
              <div class="sec_heading h2">{{ block.settings.heading }}</div>
            {% endif %}
            {% if block.settings.content != blank %}<div class="sec_content">{{ block.settings.content }}</div>{% endif %}
          </div>
        {% endfor %}
         <div class="slider-buttons no-js-hidden">
          <div class="prev-arrow swiper-button-prev">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
          <div class="slider-pagination"></div>
          <div class="next-arrow swiper-button-next">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
        </div>
      </div>
    </div>
    <div class="center {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
      {% if section.settings.button != blank %}
        <a {% if section.settings.link %} href="{{ section.settings.link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="button slide-button content-bottom-button 
          {% if section.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}" aria-label="{{ section.settings.button }}">
          {{ section.settings.button }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
{%- endstyle -%}



{% schema %}
  {
    "name": "Stacked slider",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "Title setting"
      },
      {
        "type": "text",
        "id": "main_subheading",
        "label": "Subheading",
        "default": "Brand"
      },
      {
        "type": "textarea",
        "id": "main_heading",
        "label": "Heading",
        "default": "About your brand"
      },
      {
        "type": "richtext",
        "id": "main_paragraph",
        "label": "Content",
        "default": "<p>Pair text with an image to focus on your chosen product.</p>"
      },
      {
        "type": "select",
        "id": "main_title_alignment",
        "label": "Text alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center"
      },
      {
        "type": "header",
        "content": "Image height settings"
      },
      {
        "type": "range",
        "id": "height_ratio",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Desktop image height ratio",
        "default": 100
      },
      {
        "type": "header",
        "content": "Button settings"
      },
      {
        "type": "text",
        "id": "button",
        "label": "Button",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Button link"
      },
      {
        "type": "checkbox",
        "id": "button_style_secondary_1",
        "default": false,
        "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "section_color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "color_scheme",
        "id": "content_color_scheme",
        "label": "Content color scheme",
        "default": "scheme-4"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
     "blocks": [
      {
        "type": "column",
        "name": "Column",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "default": "Your brand",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "content",
            "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
            "label": "Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Stacked Slider",
         "blocks": [
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          }
        ]
      }
    ]
  }
{% endschema %}