<link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="main-wishlist-page grid grid--4-col-desktop grid--3-col-large-tab grid--2-col-tab grid--1-col-mobile page-width section-{{ section.id }}-padding" grid-wishlist></div>
<div class="wishlist-empty page-width">
  <div class="center">
    <div class="h2">
      {{ 'sections.collection_template.empty' | t -}}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding{
    margin-bottom: 0;
  }
  .wishlist-page {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .wishlist-page {
      padding-top: {{ section.settings.padding_top | times: 0.67 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .wishlist-page {
      padding-top: {{ section.settings.padding_top | times: 0.33 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px;
    }
  }
{% endstyle %}

{% schema %}
  {
    "templates": ["page"],
    "name": "Wishlist",
    "class": "wishlist-page collection",
    "settings": [
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ]
  }
{% endschema %}