<div class="zoom-animation-section section-{{ section.id }}-padding">
   <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
     <div class="hero-content">
       <div class="hero-zoom-img"></div>
       <div class="image-containers">
         {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100 zoom-img-animation' }}
          {% else %}
            {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg zoom-img-animation' }}
          {% endif %}
       </div>
     </div>
   </div>
</div>

{%- style -%}
  {% if section.settings.bg_img != blank %}
    .hero-content .hero-zoom-img {
      background-image: url({% if section.settings.bg_img != blank %} {{ section.settings.bg_img | img_url: 'master' }} {% endif %});
    }
  {% endif %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{%- endstyle -%}


{% schema %}
  {
    "name": "Image zoom animation",
    "tag": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "t:sections.featured-collection.settings.full_width.label",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "bg_img",
        "label": "Image"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Image zoom animation"
      }
    ]
  }
{% endschema %}