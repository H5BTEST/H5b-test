<div class="video-with-text section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  {% if section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
    <div class="page-width">
      <div class="video__title title-bottom-space {{ section.settings.main_title_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
        {% if section.settings.main_subheading != blank %}<div class="sec_subheading">{{ section.settings.main_subheading }}</div>{% endif %}
        {% if section.settings.main_heading != blank %}<div class="sec_heading h2">{{ section.settings.main_heading }}</div>{% endif %}
        {% if section.settings.main_paragraph != blank %}<div class="sec_content">{{ section.settings.main_paragraph }}</div>{% endif %}
      </div>
    </div>
  {% endif %}
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <slider-component class="swiper-container video-product-slider {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}"
        data-desktop="{{ section.settings.columns_desktop }}" data-largetablet="{{ section.settings.columns_large_tablet }}"
        data-tablet="{{ section.settings.columns_tablet }}" data-mobile="{{ section.settings.columns_mobile }}" data-autoplay="{{ section.settings.autoplay_enable }}"
        data-loop="{{ section.settings.loop }}" data-speed="{{ section.settings.speed }}" data-desktopspace="{{ settings.spacing_grid_horizontal }}" data-mobilespace="{{ settings.spacing_grid_horizontal | divided_by: 2 }}">
        <ul class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <li class="swiper-slide content-{{ block.id }}">
              <div class="video-card">
                {% if block.settings.local_url != blank %}
                  <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                    <video id="Mp4Video-{{ section.id }}" class="about_video" data-type="mp4"
                      src="{{ block.settings.local_url }}" loop muted playsinline autoplay></video>
                  </div>
                {% else %}
                  <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                    {{ 'collection-4' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
                  </div>
                {% endif %}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {% if section.settings.arrows%}
          <div class="swiper-buttons">
            <div class="swiper-button-next video-swiper-button-next">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
            <div class="swiper-button-prev video-swiper-button-prev">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
          </div>
        {% endif %}
        {% if section.settings.dots-%}
          <div class="swiper-pagination video-swiper-pagination" id="swiper-pagination-{{section.id}}" style="position: inherit;"></div>
        {% endif %}
      </slider-component>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{%- endstyle -%}

{% schema %}
  {
    "name": "Video blocks",
    "tag": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.featured-collection.settings.header_text.content"
      }, 
      {
        "type": "text",
        "id": "main_subheading",
        "label": "Subheading",
        "default": "Video"
      },
      {
        "type": "textarea",
        "id": "main_heading",
        "label": "Heading",
        "default": "Your brand video"
      },
      {
        "type": "richtext",
        "id": "main_paragraph",
        "label": "Content",
        "default": "<p>Pair text with an image to focus on your chosen product.</p>"
      },
      {
        "type": "select",
        "id": "main_title_alignment",
        "label": "Text alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center"
      },
      {
        "type": "header",
        "content": "Slider settings"
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 5,
        "label": "t:sections.featured-collection.settings.columns_desktop.label"
      },
      {
        "type": "range",
        "id": "columns_large_tablet",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 4,
        "label": "Large tablet columns"
      },
      {
        "type": "range",
        "id": "columns_tablet",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 3,
        "label": "Tablet columns"
      },
      {
        "type": "range",
        "id": "columns_mobile",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2,
        "label": "Mobile columns"
      },
      {
        "type": "checkbox",
        "id": "autoplay_enable",
        "label": "Autoplay",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "arrows",
        "label": "Navigation arrows",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "dots",
        "label": "Pagination dots",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": false
      },
      {
        "type": "text",
        "id": "speed",
        "label": "Slide speed",
        "default": "500"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "info": "t:sections.all.colors.has_cards_info",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "column",
        "name": "Column",
        "settings": [
          {
            "type": "url",
            "id": "local_url",
            "label": "Local link",
            "info": "Local video CDN link here."
          },
          {
            "type": "range",
            "id": "height_ratio",
            "min": 20,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "Image height ratio",
            "default": 60
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Video blocks",
        "blocks": [
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          }
        ]
      }
    ]
  }
{% endschema %}