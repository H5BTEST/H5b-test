<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding compare-img-section">  
  {% if section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
    <div class="page-width">
      <div class="main__title title-bottom-space {{ section.settings.main_title_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
        {% if section.settings.main_subheading != blank %}<div class="sec_subheading">{{ section.settings.main_subheading }}</div>{% endif %}
        {% if section.settings.main_heading != blank %}<div class="sec_heading h2">{{ section.settings.main_heading }}</div>{% endif %}
        {% if section.settings.main_paragraph != blank %}<div class="sec_content">{{ section.settings.main_paragraph }}</div>{% endif %}
      </div>
    </div>
  {% endif %}
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    {% if section.settings.animation_style == 'scroll' %}
      <a {% if section.settings.link %} href="{{ section.settings.link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="before-after" aria-label="{{ section.settings.link }}" data-animation-style="{{ section.settings.animation_style }}"  data-section-id="{{ section.id }}">
    {% else %}
      <div class="before-after animate ad-2" data-animation-style="{{ section.settings.animation_style }}" data-section-id="{{ section.id }}">
    {% endif %}
      <div class="before-after__before-image">
       {% if section.settings.before_img != blank %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ section.settings.before_img | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
          </div>
        {% else %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
          </div>
        {% endif %}
      </div>
    
      <div class="before-after__after-image">
        {% if section.settings.after_img != blank %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ section.settings.after_img | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
          </div>
        {% else %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ 'collection-4' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
          </div>
        {% endif %}
      </div>
    
      <div class="before-after__cursor-wrapper">
        <split-cursor class="before-after__cursor" style="--background: 255 255 255">
          {% if section.settings.animation_style == 'drag' %}
            <svg role="presentation" focusable="false" fill="none" width="68" height="68" viewBox="0 0 68 68">
              <g>
                <rect width="60" height="60" x="4" y="2" fill="#ffffff" rx="30"></rect>
                <path fill="#000000" d="M28 26h1.5v12H28zM33 26h1.5v12H33zM38 26h1.5v12H38z"></path>
              </g>
            </svg>
          {% endif %}
        </split-cursor>
      </div>
    {% if section.settings.animation_style == 'scroll' %}</a>{% else %}</div>{% endif %}
  </div>
</div>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
#shopify-section-{{ section.id }} {
  --clip-path-offset: 0;
  --before-after-initial-drag-position: 50%;
}
{% endstyle %}

{% schema %}
  {
    "name": "Before after",
    "class": "custom-before-after",
    "tag": "section",
    "settings": [
       {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.featured-collection.settings.header_text.content"
      }, 
      {
        "type": "text",
        "id": "main_subheading",
        "label": "Subheading",
        "default": "Collection"
      },
      {
        "type": "textarea",
        "id": "main_heading",
        "label": "Heading",
        "default": "Before After"
      },
      {
        "type": "richtext",
        "id": "main_paragraph",
        "label": "Content",
        "default": "<p>Pair text with an image to focus on your chosen product.</p>"
      },
      {
        "type": "select",
        "id": "main_title_alignment",
        "label": "Text alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center"
      },
      {
        "type": "select",
        "id": "animation_style",
        "label": "Animation style",
        "options": [
          {
            "value": "drag",
            "label": "Drag"
          },
          {
            "value": "scroll",
            "label": "On scroll"
          }
        ],
        "default": "scroll"
      },
      {
        "type": "header",
        "content": "Image settings"
      },
      {
        "type": "image_picker",
        "id": "before_img",
        "label": "Before img"
      },
      {
        "type": "image_picker",
        "id": "after_img",
        "label": "After img"
      },
      {
        "type": "range",
        "id": "height_ratio",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Image height ratio",
        "default": 40
      },
      {
        "type": "url",
        "id": "link",
        "label": "Image link"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Before after"
      }
    ]
  }
{% endschema %}