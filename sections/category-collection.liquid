<div class="collection_section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
   {% if section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
      <div class="page-width">
        <div class="collection_title_wrap title-bottom-space {{ section.settings.text_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
          {% if section.settings.main_subheading != blank %}<div class="sec_subheading">{{ section.settings.main_subheading }}</div>{% endif %}
          {% if section.settings.main_heading != blank %}<div class="sec_heading h2">{{ section.settings.main_heading }}</div>{% endif %}
          {% if section.settings.main_paragraph != blank %}<div class="sec_content">{{ section.settings.main_paragraph }}</div>{% endif %}
        </div>
      </div>
    {% endif %}
    <div class="category_style_wrapper {% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
      <div class="main_collections_list_wrapper swiper-container"
        data-desktop="{{ section.settings.collection-desktop }}" data-largetablet="{{ section.settings.collection-large-tablet }}" data-tablet="{{ section.settings.collection-tablet }}" 
        data-mobile="{{ section.settings.collection-mobile }}" data-autoplay="{{ section.settings.autoplay-enable }}"
        data-speed="{{ section.settings.speed }}" data-loop="{{ section.settings.loop }}" data-desktopspace="{{ settings.spacing_grid_horizontal }}" data-mobilespace="{{ settings.spacing_grid_horizontal | divided_by: 2 }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
          {% if block.type == 'collection' %}
          {%- assign featured_collection = collections[block.settings.collection] -%}
          {%- assign featured_image = block.settings.image -%}
          {%- assign collectionTitle = featured_collection.title | default: 'Collection' -%}
          <div class="swiper-slide">
            <a {% if featured_collection.url==blank %} role="link" aria-disabled="true" {% else %} href="{{ featured_collection.url }}" {% endif %} aria-label="{{ block.settings.title }}" 
              class="collection__image_wrapper {% if section.settings.category_style == 'top' %}bottom-name{% endif %} {% if settings.animations_reveal_on_scroll %}scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}>
              <div class="category_img {{ section.settings.img_style }}">
                {%- if featured_image != blank and featured_collection != blank -%}
                  <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.img-ratio }}%">
                    {{ featured_image | image_url: width: 1920 | image_tag : class: 'w-100' }}
                  </div>
                {%- elsif featured_collection != blank and featured_image == blank -%}
                  {%- if featured_collection.image -%}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.img-ratio }}%">
                      {{ featured_collection.image | image_url: width: 1920 | image_tag : class: 'w-100' }}
                    </div>
                  {%- elsif featured_collection.products.first and featured_collection.products.first.featured_image -%}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.img-ratio }}%">
                      {{ featured_collection.products.first.featured_image | image_url: width: 1920 | image_tag : class: 'w-100' }}
                    </div>
                  {% else %}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.img-ratio }}%">
                      {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                      {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                    </div>
                  {%- endif -%}
                {%- else -%}
                  <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.img-ratio }}%">
                    {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                    {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  </div>
                {%- endif -%}
              </div>
              <div class="h3 text-{{ block.id }} center">
                {% if block.settings.title != blank %}
                  {{ block.settings.title }}
                {% else %}
                  {{ collectionTitle }}
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}
        {% endfor %}
        </div>
      {% if section.settings.arrows %}
      <div class="swiper-buttons">
        <div class="content-buttons">
          <div class="swiper-button-next category-swiper-button-next"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></div>
          <div class="swiper-button-prev category-swiper-button-prev"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></div>
        </div>
      </div>
      {% endif %}
      {% if section.settings.dots -%}
      <div class="swiper-pagination category-swiper-pagination" id="swiper-pagination-{{section.id}}"></div>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  {% for block in section.blocks %}
  {% if block.type == 'collection' %}
    .collection_section .text-{{ block.id }}.h3{
      color: {{ block.settings.text_color }};
    }
  {% endif %}
  {% endfor %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    }, 
    {
      "type": "text",
      "id": "main_subheading",
      "label": "Subheading",
      "default": "Best collections"
    },
    {
      "type": "textarea",
      "id": "main_heading",
      "label": "Heading",
      "default": "Category collection"
    },
    {
      "type": "richtext",
      "id": "main_paragraph",
      "label": "Content",
      "default": "<p>Pair text with an image to focus on your chosen product.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "collection-desktop",
      "min": 1,
      "max": 10,
      "step": 0.2,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "collection-large-tablet",
      "min": 1,
      "max": 7,
      "step": 0.2,
      "default": 3,
      "label": "Large tablet columns"
    },
    {
      "type": "range",
      "id": "collection-tablet",
      "min": 1,
      "max": 6,
      "step": 0.2,
      "default": 3,
      "label": "Tablet columns"
    },
    {
      "type": "range",
      "id": "collection-mobile",
      "min": 1,
      "max": 6,
      "step": 0.2,
      "default": 2,
      "label": "Mobile columns"
    },
    {
      "type": "checkbox",
      "id": "autoplay-enable",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Navigation arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "text",
      "id": "speed",
      "label": "Slide speed",
      "default": "800"
    },
    {
      "type": "select",
      "id": "img_style",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "label": "Category image style",
      "default": "square"
    },
    {
      "type": "select",
      "id": "category_style",
      "options": [
        {
          "value": "top",
          "label": "Category name top"
        },
        {
          "value": "bottom",
          "label": "Category name bottom"
        }
      ],
      "label": "Category name position",
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "img-ratio",
          "min": 20,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Image height ratio",
          "default": 100
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection",
          "default": "collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category collection",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}