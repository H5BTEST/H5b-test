<div class="hero-slideshow home-slideshow-section slideshow-{{ section.id }} {% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
  <div class="slider_section">
    <div class="classic-container swiper-container {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2{% endif %}"
      data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.slideshow_speed}}" data-loop="{{ section.settings.loop_enable }}" data-arrows="{{ section.settings.arrows }}">
       <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide slider-{{ block.id }}" data-id="{{ block.id }}">
              {%- if block.settings.slider_type == 'video' -%}
                {% if block.settings.hero_slideshow_link_video != blank %}
                <div class="hero-slideshow_video">
                  <div class="slideshow-img media media--transparent ratio w-100" style="--ratio-percent: 100%">
                    <video id="Mp4{{ section.id }}" src="{{ block.settings.hero_slideshow_link_video }}" loop="" muted="" playsinline="" autoplay="" class="swiper-image"></video>
                  </div>
                </div>
                {% else %}
                  <div class="slideshow-img desktop-only media media--transparent ratio w-100" style="--ratio-percent: 100%">
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  </div>
                {% endif %}
              {% endif %}
              {%- if block.settings.slider_type == 'image' -%}
                <a {% if block.settings.banner_link %} href="{{ block.settings.banner_link }}" {% else %} role="link" aria-disabled="true"{% endif %} aria-label="slider-{{ block.id }}">
                  <div class="hero-slideshow-image">
                    {% if block.settings.image != blank %}
                      <!-- <div class="image-overlay"></div> -->
                      <div class="slideshow-img desktop-only media media--transparent ratio w-100 swiper-image" style="--ratio-percent: 100%">
                        {{ block.settings.image | image_url: width: 1920 | image_tag : loading: 'eager', class: 'w-100' }}
                      </div>
                      {% else %}
                      <div class="slideshow-img desktop-only media media--transparent ratio w-100" style="--ratio-percent: 100%">
                        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      </div>
                    {% endif %}
                  
                    {% if block.settings.mobile_image != blank %}
                    <div class="slideshow-img mobile-only media media--transparent ratio w-100 swiper-image" style="--ratio-percent: 100%">
                      {{ block.settings.mobile_image | image_url: width: 1920 | image_tag : loading: 'eager', class: 'w-100' }}
                    </div>
                    {% else %}
                    <div class="slideshow-img mobile-only media media--transparent ratio w-100" style="--ratio-percent: 100%">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                    </div>
                  {% endif %}
                </div>
                </a>
            
            {% endif %}
          {% if block.settings.show_content %}
            <div class="slider-content slider-content--{{ block.settings.content_position }} slider-mobile-content--{{ block.settings.mobile_content_position }}">
             <div class="slide_{{forloop.index}} slider-content--{{ block.settings.text_alignment }} slider-mobile-content--{{ block.settings.mobile_text_alignment }} color-{{ block.settings.color_scheme }} gradient">
                {% if block.settings.title_2 != blank %}
                  <span class="slide-sub-heading-2 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                    {{ block.settings.title_2 }}
                  </span>
                {% endif %}
               
                {% if block.settings.title != blank %}
                  <div class="slide-heading h2 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                    {{ block.settings.title }}
                  </div>
                 
                {% endif %}
            
                {% if block.settings.desc != blank %}
                  <p class="slide-text {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                    {{ block.settings.desc }}
                  </p>
                {% endif %}
            
                <div class="multiple-buttons {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                  {% if block.settings.button != blank %}
                  <a {% if block.settings.link %} href="{{ block.settings.link }}" {% else %} role="link" aria-disabled="true" {%
                    endif %} class="button slide-button {% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}" aria-label="{{ block.settings.button }}">{{ block.settings.button }}</a>
                  {% endif %}
                  {% if block.settings.button_2 != blank %}
                  <a {% if block.settings.link_2 %} href="{{ block.settings.link_2 }}" {% else %} role="link" aria-disabled="true"
                    {% endif %} class="button slide-button {% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}" aria-label="{{ block.settings.button_2 }}">{{ block.settings.button_2 }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if section.settings.arrows %}
        <div class="swiper-{{ section.id}}-arrows swiper-arrows">
          <div class="swiper-button-next slider-swiper-button-next" id="swiper-button-next-{{section.id}}">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
          <div class="swiper-button-prev slider-swiper-button-prev" id="swiper-button-prev-{{section.id}}">{{- 'icon-caret.svg' | inline_asset_content -}}</div>
        </div>
        {% endif %}
        {% if section.settings.dots -%}
        <div class="swiper-pagination slider-swiper-pagination swiper-pagination--{{ section.settings.carousel_pagination_alignment }}" id="swiper-pagination-{{section.id}}"></div>
        {% endif %}
    </div>
  </div>
</div>



{% style %}
  .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
    height: {{ section.settings.slider_height }}px;
  }
  @media(max-width: 1429px){
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
      height: {{ section.settings.slider_height_large_lap }}px;
    }
  }
  @media(max-width: 1199px){
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
      height: {{ section.settings.slider_height_lap }}px;
    }
  }
  @media(max-width: 991px){
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
      height: {{ section.settings.slider_height_large_tab }}px;
    }
  }
  @media(max-width: 767px){
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
      height: {{ section.settings.slider_height_tab }}px;
    }
  }
  @media(max-width: 575px){
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container { 
      height: {{ section.settings.slider_height_mobile }}px;
    }
  }
  {% for block in section.blocks %}
    .home-slideshow-section.slideshow-{{ section.id }} .classic-container .slider-{{ block.id }} .slider-content [class*="slide_"]::after { 
      background-color: rgb(var(--color-background), {{ block.settings.overlay | divided_by: 100.0 }});
    }
  
    .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading {
      font-size: {{ block.settings.heading_size }}px;
    }
    @media screen and (max-width: 1399px){
      .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading{ 
        font-size: {{ block.settings.heading_size | times: 0.75 | round: 0 }}px;
      }
    }
    @media screen and (max-width: 1199px){
      .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading { 
        font-size: {{ block.settings.heading_size | times: 0.65 | round: 0 }}px;
      }
    }
    @media screen and (max-width: 991px){
      .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading{ 
        font-size: {{ block.settings.heading_size | times: 0.5 | round: 0 }}px;
      }
    }
    @media screen and (max-width: 767px){
      .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading { 
        font-size: {{ block.settings.heading_size | times: 0.35 | round: 0 }}px;
      }
    }
    @media screen and (max-width: 575px){
      .home-slideshow-section.slideshow-{{ section.id }} .slider-{{ block.id }} .slide-heading { 
        font-size: {{ block.settings.heading_size | times: 0.25 | round: 0 }}px;
      }
    }
    @media screen and (min-width: 320px) and (max-width: 767px){
      .desktop-only {
        display: none;
      }
    }
  {% endfor %}
{% endstyle %}


{% schema %}
