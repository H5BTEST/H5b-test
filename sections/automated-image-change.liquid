<div class="automated-image-change section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }}">
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <div class="automated-image-wrapper">
    {%- for block in section.blocks -%}
      <div class="image-wrapper grid product-grid grid--4-col-desktop grid--3-col-tablet grid--2-col-tablet-down">
        <div class="grid__item image-animation">
          {% if block.settings.image1 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ block.settings.image1 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
          {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
            </div>
          {% endif %}
        </div>
        <div class="grid__item image-animation">
          {% if block.settings.image2 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ block.settings.image2 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
          {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
            </div>
          {% endif %}
        </div>
        <div class="grid__item image-animation">
          {% if block.settings.image3 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ block.settings.image3 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
          {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
            </div>
          {% endif %}
        </div>
         <div class="grid__item image-animation">
          {% if block.settings.image4 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ block.settings.image4 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
          {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
              {{ 'collection-4' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    </div>
  </div>
</div>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Automated image change",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Top bottom padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "range",
          "id": "height_ratio",
          "min": 20,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Image height ratio",
          "default": 100
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image3",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image4",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Automated image change",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}