<div style="height: 300vh;" class="section-{{ section.id }}-padding">
  <div style="position: sticky; top: 0; height: 100vh; overflow: hidden;">
    <canvas id="videoCanvas" style="width: 100%; height: 100%;"></canvas>
  </div>
</div>

{% style %}
#videoCanvas {
  transform: translateZ(0);
  will-change: transform;
}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
{% endstyle %}

<script>
  const canvas = document.getElementById("videoCanvas");
  const ctx = canvas.getContext("2d");

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resizeCanvas();
  window.addEventListener("resize", resizeCanvas);

  const video = document.createElement("video");
  video.src = "https://cdn.shopify.com/videos/c/o/v/fd007496d8f0407bacc0f473d09173c6.mp4";
  video.crossOrigin = "anonymous";
  video.muted = true;
  video.playsInline = true;
  video.preload = "auto";
  video.pause();

  let duration = 0;
  let scrollTarget = 0;
  let scrollCurrent = 0;
  let playing = false;

  // 🟢 Draw first frame after video is loaded
  video.addEventListener("loadedmetadata", () => {
    duration = video.duration;

    // ✅ Set time to 0 and draw immediately
    video.currentTime = 0;

    video.requestVideoFrameCallback(() => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    });

    // 🟢 Scroll-driven rendering
    window.addEventListener("scroll", () => {
      const scrollY = window.scrollY;
      const maxScroll = document.body.scrollHeight - window.innerHeight;
      scrollTarget = Math.min(scrollY / maxScroll, 1);

      if (!playing) {
        playing = true;
        drawVideoFrame();
      }

      clearTimeout(window._scrollEnd);
      window._scrollEnd = setTimeout(() => {
        playing = false;
      }, 60);
    });
  });

  function drawVideoFrame() {
    scrollCurrent += (scrollTarget - scrollCurrent) * 0.1;

    const newTime = scrollCurrent * duration;
    video.currentTime = newTime;

    video.requestVideoFrameCallback(() => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    });

    if (playing) requestAnimationFrame(drawVideoFrame);
  }
</script>

{% schema %}
  {
    "name": "Video animation",
    "settings": [
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "info": "t:sections.all.colors.has_cards_info",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Video animation"
      }
    ]
  }
{% endschema %}