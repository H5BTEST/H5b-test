<style>
    /* CSS */
/* Sticky Bottle */
.sticky-bottle {
  position: relative;
  {% comment %} height: 300vh; {% endcomment %}
}
.bottle.active{
    right: 0;
    left: auto;
}
.bottle {
     position: fixed;
     top: 0;
    left: 50%;
    {% comment %} top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); {% endcomment %}
    z-index: 50;
    {% comment %} width: 100vw; {% endcomment %}
}
.bottle {
  {% comment %} max-height: 80vh; {% endcomment %}
  opacity: 1;
  transition: opacity 0.5s ease;
}
.video {
  position: fixed;
  top: 0;
  left: 50%;
  z-index: 50;
  transform: translate(-50%, 0px);
  max-width: 80vw;
  {% comment %} max-height: 80vh; {% endcomment %}
   {% comment %} top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); {% endcomment %}
    opacity: 0;
    z-index: 50;
  transition: opacity 0.5s ease;
}

</style>


