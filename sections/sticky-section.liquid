<div class="sticky-section section-{{ section.id }}-padding color-{{ section.settings.section_color_scheme }} gradient" data-stickystyle="{{ section.settings.sticky_style }}">
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    {%- for block in section.blocks -%}
      <div class="content--sticky">
         <div class="content__inner {{ block.settings.image_position }} {% if block.settings.show_shadow %}content-shadow{% endif %}">
            <div class="sticky-left-part">
              <div class="first-part-img {% if template contains 'about' or template contains 'product' %}about-page{% endif %}">
                  {%- if block.settings.banner_type == 'image' -%}
                    {% if block.settings.image != blank %}
                      <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                        {{ block.settings.image | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
                      </div>
                    {% else %}
                      <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                        {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
                      </div>
                    {% endif %}
                  {% endif %}
                {%- if block.settings.banner_type == 'video' -%}
                  {% if block.settings.local_url != blank %}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                      <video id="Mp4Video-{{ section.id }}" class="about_video" data-type="mp4"
                        src="{{ block.settings.local_url }}" loop muted playsinline autoplay></video>
                    </div>
                  {% else %}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                      {{ 'collection-4' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
                    </div>
                  {% endif %}
                {%- endif -%}
      
                {%- if block.settings.banner_type == 'online-video' -%}
                  {% if block.settings.video_url != blank %}
                    <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height_ratio }}%">
                      {%- if block.settings.video_url.type == 'youtube' -%}
                      <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?enablejsapi=1"
                        class="js-youtube" allow="autoplay; encrypted-media" allowfullscreen
                        title="{{ block.settings.description | escape }}"></iframe>
                      {%- else -%}
                      <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" class="js-vimeo"
                        allow="autoplay; encrypted-media" allowfullscreen
                        title="{{ block.settings.description | escape }}"></iframe>
                      {%- endif -%}
                    </div>
                  {% else %}
                    {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
                  {% endif %}
                {%- endif -%}
              </div>
            </div>
            <div class="sticky-right-part">
              <div class="sticky-wrapper color-{{ section.settings.content_color_scheme }} gradient">
                <div class="sticky_title {{ block.settings.main_title_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                  {% if block.settings.subheading != blank %}
                    <div class="sec_subheading">{{ block.settings.subheading }}</div>
                  {% endif %}
                  {%- if block.settings.title != blank -%}
                    <div class="sec_heading h2">{{ block.settings.title }}</div>
                  {%- endif -%}
                  {% if block.settings.description != blank %}
                    <p class="sec_content">{{ block.settings.description }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <a {% if block.settings.button_link %} href="{{ block.settings.button_link }}" {% else %}
                      role="link" aria-disabled="true" {% endif %} class="button {% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}">
                      {{ block.settings.button_label }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
         </div>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{% endstyle %}

{% schema %}
  {
    "name": "Sticky section",
    "tag": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "select",
        "id": "sticky_style",
        "options": [
          {
            "value": "with-effect",
            "label": "With effect"
          },
          {
            "value": "without-effect",
            "label": "Without effect"
          }
        ],
        "default": "with-effect",
        "label": "Section sticky style"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "section_color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "color_scheme",
        "id": "content_color_scheme",
        "label": "Content color scheme",
        "default": "scheme-4"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "column",
        "name": "Column",
        "settings": [
          {
            "type": "header",
            "content": "Left part setting"
          },
          {
            "type": "select",
            "id": "banner_type",
            "options": [
              {
                "value": "image",
                "label": "Image"
              },
              {
                "value": "video",
                "label": "Local video"
              },
              {
                "value": "online-video",
                "label": "Online video"
              }
            ],
            "default": "image",
            "label": "Image settings"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "local_url",
            "label": "Local link",
            "info": "Local video CDN link here."
          },
          {
            "type": "video_url",
            "id": "video_url",
            "accept": [
              "youtube",
              "vimeo"
            ],
            "label": "Online link",
            "info": "Youtube or Vimeo link here",
            "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
          },
          {
            "type": "range",
            "id": "height_ratio",
            "min": 20,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "Image height ratio",
            "default": 60
          },
          {
            "type": "header",
            "content": "Left part setting"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "About your brand"
          },
          {
            "type": "textarea",
            "id": "title",
            "default": "About us",
            "label": "Heading"
          },
          {
            "type": "textarea",
            "id": "description",
            "default": "Pair text with an image to focus on your chosen product, collection, or about us content.",
            "label": "Content"
          },
          {
            "type": "text",
            "id": "button_label",
            "label": "Button label",
            "default": "Button label"
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "checkbox",
            "id": "button_style_secondary_1",
            "default": false,
            "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
          },
          {
            "type": "select",
            "id": "main_title_alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "center",
            "label": "Main title alignment"
          },
          {
            "type": "select",
            "id": "image_position",
            "options": [
              {
                "value": "left-image",
                "label": "Left image"
              },
              {
                "value": "right-image",
                "label": "Right image"
              }
            ],
            "default": "left-image",
            "label": "Image position"
          },
          {
            "type": "checkbox",
            "id": "show_shadow",
            "label": "Show box shadow",
            "default": true
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Sticky section",
        "blocks": [
          {
            "type": "column"
          },
          {
            "type": "column"
          },
          {
            "type": "column"
          }
        ]
      }
    ]
  }
{% endschema %}