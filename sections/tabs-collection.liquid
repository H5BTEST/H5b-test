{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .tab-{{ section.id }}.tab_collection-slider .collection__title {
    text-align: {{ section.settings.main_title_alignment }};
  }
  .tab-{{ section.id }}.tab_collection-slider .tab-product-collection ul.tabs {
    justify-content: {{ section.settings.main_title_alignment }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{%- endstyle -%}

{% assign show_desktop_slider = false %}

{% for block in section.blocks %}
  {% if block.type == 'tabination' %}
    {%- assign products_to_display = block.settings.tab_product.all_products_count %}

    {% if block.settings.tab_product.all_products_count > section.settings.products_to_show %}
      {%- assign products_to_display = section.settings.products_to_show %}
      {%- assign more_in_collection = true %}
    {% endif %}

    {%- if section.settings.enable_desktop_slider and products_to_display >= section.settings.columns_desktop %}
      {%- assign show_desktop_slider = true %}
    {% endif %}
  {% endif %}
{% endfor %}

<div class="tab_collection-slider color-{{ section.settings.color_scheme }} gradient tab-{{ section.id }} isolate d-inline-block section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="collection__title title-bottom-space">
      {% if section.settings.collections_subtitle != blank %}
        <div class="sec_subheading">{{ section.settings.collections_subtitle }}</div>
      {% endif %}
      {%- if section.settings.collections_title != blank -%}
        <div class="sec_heading h2 inline-richtext">{{ section.settings.collections_title }}</div>
      {%- endif -%}
      {% if section.settings.collections_description != blank %}
        <div class="sec_content">{{ section.settings.collections_description }}</div>
      {% endif %}
      <div class="tab-collection-main">
        <ul class="tabs">
          {% for block in section.blocks %}
            {% case block.type %}
            {% when 'tabination' %}
            {% assign category_product = collections[block.settings.tab_product] %}
            {% if block.settings.tab_product != blank %}
            <li>
              {% if block.settings.tab_name == blank %}
                <a href="#tab--{{ forloop.index }}" class="{% if forloop.first == true %}active{% endif %}" aria-label="{{ category_product.title }}">{{ category_product.title }}</a>
              {% else %}
                <a href="#tab--{{ forloop.index }}" class="{% if forloop.first == true %}active{% endif %}" aria-label="{{ block.settings.tab_name }}">{{ block.settings.tab_name }}</a>
              {% endif %}
            </li>
            {% else %}
            <li>
              <a href="#tab--{{ forloop.index }}" class="{% if forloop.first == true %}active{% endif %}" aria-label="Collection">Collection</a>
            </li>
            {% endif %}
            {% endcase %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
  <div class="collection{% if settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %} tab-product-collection {% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}
      {% when 'tabination' %}
        <div id="tab--{{ forloop.index }}" class="product-collection-tab-grid" {% if forloop.first %} style="display: block;"{% else %} style="display: none;"{% endif %}>
          <slider-component class="{% if section.settings.enable_desktop_slider == true %}swiper-container tab-slider{% endif %}"
            data-enable="{{ section.settings.enable_desktop_slider }}"
            data-desktop="{{ section.settings.columns_desktop }}" data-largetablet="{{ section.settings.columns_large_tablet }}"
            data-tablet="{{ section.settings.columns_tablet }}" data-mobile="{{ section.settings.columns_mobile }}" data-autoplay="{{ section.settings.autoplay_enable }}"
            data-loop="{{ section.settings.loop }}" data-speed="{{ section.settings.speed }}" data-desktopspace="{{ settings.spacing_grid_horizontal }}" data-mobilespace="{{ settings.spacing_grid_horizontal | divided_by: 2 }}">
            <ul
              id="Slider-{{ section.id }}"
              class="{% if section.settings.enable_desktop_slider == true %}swiper-wrapper{% endif %} product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %}
              {% if section.settings.enable_desktop_slider == false %}grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_large_tablet }}-col-large-tab grid--{{ section.settings.columns_tablet }}-col-tab grid--{{ section.settings.columns_mobile }}-col-mobile{% endif %}"
              role="list"
              aria-label="{{ 'general.slider.name' | t }}"
            >
              {% assign skip_card_product_styles = false %}
              {%- if block.settings.tab_product.products.size > 0 -%}
                {% paginate block.settings.tab_product.products by section.settings.products_to_show %}
                  {%- for product in block.settings.tab_product.products limit: section.settings.products_to_show -%}
                    <li
                      id="Slide-{{ section.id }}-{{ forloop.index }}"
                      class="{% if section.settings.enable_desktop_slider == false %}grid__item{% endif %} {% if section.settings.enable_desktop_slider == true %}swiper-slide{% endif %}"
                    >
                      {% render 'second-card-product',
                        card_product: product,
                        media_aspect_ratio: settings.image_ratio,
                        image_shape: settings.image_shape,
                        show_secondary_image: settings.show_secondary_image,
                        show_vendor: settings.show_card_vendor,
                        show_rating: settings.show_rating,
                        skip_styles: skip_card_product_styles,
                        section_id: section.id,
                        quick_add: settings.quick_add
                      %}
                    </li>
                    {%- assign skip_card_product_styles = true -%}
                  {%- endfor -%}
                {% endpaginate %}
              {%- else -%}
                {%- for i in (1..section.settings.columns_desktop) -%}
                  <li
                    class="{% if section.settings.enable_desktop_slider == false %}grid__item{% endif %} {% if section.settings.enable_desktop_slider == true %}swiper-slide{% endif %}"
                  >
                    {% liquid
                      assign ridx = forloop.rindex
                      case ridx
                        when 5
                          assign ridx = 1
                        when 6
                          assign ridx = 2
                      endcase
                    %}
                    {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
                    {% render 'card-product',
                      show_vendor: settings.show_card_vendor,
                      media_aspect_ratio: settings.image_ratio,
                      image_shape: settings.image_shape,
                      placeholder_image: placeholder_image
                    %}
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
            {% if section.settings.arrows and section.settings.enable_desktop_slider %}
            <div class="swiper-buttons">
              <div class="swiper-button-next tab-swiper-button-next"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></div>
              <div class="swiper-button-prev tab-swiper-button-prev"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></div>
            </div>
          {% endif %}
          {% if section.settings.dots and section.settings.enable_desktop_slider -%}
            <div class="swiper-pagination tab-swiper-pagination" id="swiper-pagination-{{section.id}}" style="position: inherit;"></div>
          {% endif %}
            {%- if section.settings.show_view_all and more_in_collection -%}
              <div class="center collection__view-all {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                <a
                  href="{{ section.settings.collection.url }}"
                  class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
                >
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {%- endif -%}
          </slider-component>
        </div>
      {% endcase %}
    {% endfor %}
    {% if settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var tabLinks = document.querySelectorAll(".tabs li a");
  var tabContents = document.querySelectorAll(".product-collection-tab-grid");

  function switchTab(newIndex) {
    let activeTab = document.querySelector(".product-collection-tab-grid.active");
    let newTab = tabContents[newIndex];

    if (activeTab !== newTab) {
      gsap.to(activeTab, {
        opacity: 0,
        y: 15,
        duration: 0.4,
        ease: "power2.out",
        onComplete: function () {
          activeTab.classList.remove("active");
          activeTab.style.display = "none";

          newTab.style.display = "block";
          gsap.fromTo(
            newTab,
            { opacity: 0, y: 15 },
            { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }
          );
          newTab.classList.add("active");
        },
      });
    }
  }

  tabLinks.forEach((link, index) => {
    link.addEventListener("click", function (e) {
      e.preventDefault();
      tabLinks.forEach((tabLink) => tabLink.classList.remove("active"));
      this.classList.add("active");
      switchTab(index);
    });
  });

  let firstTab = document.querySelector(".product-collection-tab-grid");
  firstTab.style.display = "block";
  firstTab.classList.add("active");
});

</script>

{% schema %}
{
  "name": "Tabs collection",
  "tag": "section",
  "class": "section tab_collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Title settings"
    },
    {
      "type": "text",
      "id": "collections_subtitle",
      "label": "Subheading",
      "default": "Text about your branding"
    },
    {
      "type": "textarea",
      "id": "collections_title",
      "label": "t:sections.multicolumn.settings.title.label",
      "default": "Tabs collection"
    },
    {
      "type": "richtext",
      "id": "collections_description",
      "label": "t:sections.featured-collection.settings.description.label",
      "default": "<p>Pair text with an image to focus on your brand and description of your brand.</p>"
    },
    {
      "type": "select",
      "id": "main_title_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "header",
      "content": "Collection settings"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 6,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_large_tablet",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 3,
      "label": "Large tablet columns"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 2,
      "label": "Tablet columns"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "default": 2,
      "label": "Mobile columns"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "t:sections.featured-collection.settings.enable_desktop_slider.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay_enable",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Navigation arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "text",
      "id": "speed",
      "label": "Slide speed",
      "default": "800"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:sections.featured-collection.settings.view_all_style.label",
      "options": [
        {
          "value": "link",
          "label": "t:sections.featured-collection.settings.view_all_style.options__1.label"
        },
        {
          "value": "outline",
          "label": "t:sections.featured-collection.settings.view_all_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:sections.featured-collection.settings.view_all_style.options__3.label"
        }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Top bottom padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tabination",
      "name": "Tabination",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "tab_product",
          "label": "t:sections.featured-collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "tab_name",
          "label": "Collection name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs collection",
      "blocks": [
        {
          "type": "tabination"
        },
        {
          "type": "tabination"
        },
        {
          "type": "tabination"
        }
      ]
    }
  ]
}
{% endschema %}