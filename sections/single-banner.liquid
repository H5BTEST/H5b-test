<div class="color-{{ section.settings.color_scheme }} gradient single-banner-section {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}">
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <div class="single-banner-wrapper section-{{ section.id }}-padding">
      <div class="{% if section.settings.full_width == true %}page-width{% else %}banner-row{% endif %}">
        <div class="single-banner-text {{ section.settings.text_alignment }}">
          {% if section.settings.banner-subheading != blank %}
            <div class="sec_subheading">{{ section.settings.banner-subheading }}</div>
          {% endif %}
          {% if section.settings.banner-heading != blank %}
            <div class="h1">{{ section.settings.banner-heading }}</div>
          {% endif %}
          {% if section.settings.banner-content != blank %}<div class="sec_content">{{ section.settings.banner-content }}</div>{% endif %}
          {% if section.settings.show_countdown %}
            {% if section.settings.coutdown_time != '' %}
            <ul class="countdown-timer" data-time="{{ section.settings.coutdown_time }}">
              <div class="time">
                <div id="days" class="coundown-text">0</div>
                <div>Days</div>
              </div>
              <div class="time">
                <div id="hours" class="coundown-text">0</div>
                <div>Hours</div>
              </div>
              <div class="time">
                <div id="mins" class="coundown-text">0</div>
                <div>Mins</div>
              </div>
              <div class="time">
                <div id="secs" class="coundown-text">0</div>
                <div>Secs</div>
              </div>
              
              <div id="end"></div>
            </ul>
            {%- endif -%}
          {% endif %}
          {% if section.settings.button_label != blank %}
            <a {% if section.settings.button_link %} href="{{ section.settings.button_link }}" {% else %}
              role="link" aria-disabled="true" {% endif %} class="button {% if section.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}">
              {{ section.settings.button_label }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% style %}
{% if section.settings.banner-image != blank or section.settings.mobile-banner-image != blank %}
  .single-banner-wrapper{
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
{% endif %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
}
{% if section.settings.banner-image != blank %}
  @media screen and (min-width: 768px){
    .single-banner-wrapper{
      background-image: url({% if section.settings.banner-image != blank %} {{ section.settings.banner-image | img_url: 'master' }} {% endif %});
    }
  }
{% endif %}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.67 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px;
    margin-top: {{ section.settings.margin_top | times: 0.67 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.67 | round: 0 }}px;
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.45 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.45 | round: 0 }}px;
    margin-top: {{ section.settings.margin_top | times: 0.33 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.33 | round: 0 }}px;
  }
  {% if section.settings.mobile-banner-image != blank %}
    .single-banner-wrapper{
      background-image: url({% if section.settings.mobile-banner-image != blank %} {{ section.settings.mobile-banner-image | img_url: 'master' }} {% endif %});
    }
  {% endif %}
}
{% endstyle %}

{% schema %}
  {
    "name": "Single banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "Banner setting"
      },
      {
        "type": "image_picker",
        "id": "banner-image",
        "label": "Desktop image"
      },
      {
        "type": "image_picker",
        "id": "mobile-banner-image",
        "label": "Mobile image"
      },
      {
        "type": "text",
        "id": "banner-subheading",
        "label": "Subheading",
        "default": "Banner trend"
      },
      {
        "type": "textarea",
        "id": "banner-heading",
        "label": "Heading",
        "default": "Announce your offer"
      },
      {
        "type": "richtext",
        "id": "banner-content",
        "label": "Content",
        "default": "<p>Pair text with an image to focus on your chosen product, collection, or about us content.</p>",
      },
      {
        "type": "checkbox",
        "id": "show_countdown",
        "label": "Coundown",
        "default": true
      },
      {
        "type": "text",
        "id": "coutdown_time",
        "label": "End Time. Example: Dec 20, 2023 23:59:59"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Button label"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      },
      {
        "type": "checkbox",
        "id": "button_style_secondary_1",
        "default": false,
        "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
      },
      {
        "type": "select",
        "id": "text_alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center",
        "label": "Text alignment"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-4"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      },
      {
        "type": "header",
        "content": "Top bottom margin"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Single banner"
      }
    ]
  }
{% endschema %}