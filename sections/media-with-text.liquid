<div class="media-with-text color-{{ section.settings.color_scheme }} isolate gradient section-{{ section.id }}-padding">
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
     <div class="media_with_text_item">
        <div class="media-column">
          <div class="col_image {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}">
           {% if section.settings.image1 != blank %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio1 }}%">
                {{ section.settings.image1 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
              </div>
            {% else %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio1 }}%">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
              </div>
            {% endif %}
          </div>
          <div class="col_content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
            <p class="sec_heading title-bottom-space">
              <span class="text-custom">
                {{ section.settings.brand_name1 }}
              </span>
            </p>
            <div class="col_content"></div>
              <ul class="comparison">
                {%- for block in section.blocks -%}
                <li>
                  {{ section.settings.content_icon1 }}
                  {{ block.settings.content1 }}
                </li>
                {% endfor %}
              </ul>
          </div>
       </div>
        <div class="media-column">
          <div class="col_image {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}">
           {% if section.settings.image2 != blank %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio2 }}%">
                {{ section.settings.image2 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
              </div>
            {% else %}
              <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio2 }}%">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder placeholder-bg' }}
              </div>
            {% endif %}
          </div>
          <div class="col_content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
            <p class="sec_heading title-bottom-space">
              <span class="text-custom">
                {{ section.settings.brand_name2 }}
              </span>
            </p>
            <div class="col_content"></div>
              <ul class="comparison">
                {%- for block in section.blocks -%}
                <li>
                  {{ section.settings.content_icon2 }}
                  {{ block.settings.content2 }}
                </li>
                {% endfor %}
              </ul>
          </div>
       </div>
     </div>
  </div>
</div>

{% style %}
  {% if section.settings.image3 != blank %}
    .media_with_text_item:after {
      content: '';
      background-image: url({% if section.settings.image3 != blank %} {{ section.settings.image3 | img_url: 'master' }} {% endif %});
    }
  {% endif %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{% endstyle %}

{% schema %}
  {
    "name": "Media with text",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "Left column settings"
      },
      {
        "type": "image_picker",
        "id": "image1",
        "label": "Left image"
      },
      {
        "type": "range",
        "id": "height_ratio1",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Image height ratio",
        "default": 60
      },
      {
        "type": "text",
        "id": "brand_name1",
        "default": "H5b",
        "label": "Custom text"
      },
      {
        "type": "textarea",
        "id": "content_icon1",
        "default": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'><path d='M4 12C4 7.58172 7.58172 4 12 4C16.4183 4 20 7.58172 20 12C20 16.4183 16.4183 20 12 20C7.58172 20 4 16.4183 4 12ZM12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM17.4571 9.45711L16.0429 8.04289L11 13.0858L8.20711 10.2929L6.79289 11.7071L11 15.9142L17.4571 9.45711Z'></path></svg>",
        "label": "List boolean"
      },
      {
        "type": "header",
        "content": "Right column settings"
      },
      {
        "type": "image_picker",
        "id": "image2",
        "label": "Right image"
      },
      {
        "type": "range",
        "id": "height_ratio2",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Image height ratio",
        "default": 60
      },
      {
        "type": "text",
        "id": "brand_name2",
        "default": "Other Brands",
        "label": "Custom text"
      },
      {
        "type": "textarea",
        "id": "content_icon2",
        "default": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'><path d='M4 12C4 7.58172 7.58172 4 12 4C16.4183 4 20 7.58172 20 12C20 16.4183 16.4183 20 12 20C7.58172 20 4 16.4183 4 12ZM12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM17.4571 9.45711L16.0429 8.04289L11 13.0858L8.20711 10.2929L6.79289 11.7071L11 15.9142L17.4571 9.45711Z'></path></svg>",
        "label": "List boolean"
      },
      {
        "type": "image_picker",
        "id": "image3",
        "label": "Center image"
      },
      {
        "type": "header",
        "content": "Color settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "info": "t:sections.all.colors.has_cards_info",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "content",
        "name": "Content",
        "settings": [
          {
            "type": "header",
            "content": "Left part content"
          },
          {
            "type": "richtext",
            "id": "content1",
            "default": "<p>Fresh and High-Quality</p>",
            "label": "Content"
          },
          {
            "type": "header",
            "content": "Right part content"
          },
          {
            "type": "richtext",
            "id": "content2",
            "default": "<p>Fresh and High-Quality</p>",
            "label": "Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Media with text",
        "blocks": [
          {
            "type": "content"
          },
          {
            "type": "content"
          },
          {
            "type": "content"
          },
          {
            "type": "content"
          }
        ]
      }
    ]
  }
{% endschema %}