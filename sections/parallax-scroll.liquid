<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="img_column_wrapper">
    <div class="inner_column">
      {% for block in section.blocks %}
        <div class="image_column">
          {% if block.settings.image_1 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ block.settings.image_1 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
            {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
          {% endif %}
          {% if block.settings.image_2 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ block.settings.image_2 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
            {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
          {% endif %}
          {% if block.settings.image_3 != blank %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ block.settings.image_3 | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
            </div>
            {% else %}
            <div class="media media--transparent ratio" style="--ratio-percent: 110%">
              {{ 'collection-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
{% endstyle %}

{% schema %}
  {
    "name": "Parallax scroll",
    "settings": [
      {
        "type": "header",
        "content": "Color Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
    {
      "type": "image_column",
      "name": "Image Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "First Image"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Second Image"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Third Image"
        }
      ]
    }
  ],
    "presets": [
      {
        "name": "Parallax scroll",
        "blocks": [
          {
            "type": "image_column"
          },
          {
            "type": "image_column"
          },
          {
            "type": "image_column"
          },
          {
            "type": "image_column"
          }
        ]
      }
    ]
  }
{% endschema %}