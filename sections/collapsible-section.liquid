<div class="home_collapsible_content section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <div class="collapsible-row">
      <div class="collapsible-img {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
        {% if section.settings.image != blank %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ section.settings.image | image_url: width: 950 | image_tag : loading: 'lazy', class: 'w-100' }}
          </div>
          {% else %}
          <div class="media media--transparent ratio" style="--ratio-percent: {{ section.settings.height_ratio }}%">
            {{ 'collection-5' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          </div>
        {% endif %}
      </div>
       <div class="collapsible_content">
        <div class="collapsible-content">
           {% if section.settings.subheading1 != blank or section.settings.title != blank or section.settings.description != blank or section.settings.button != blank %}
            <div class="collapsible_title title-bottom-space left {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
              {%- if section.settings.subheading1 != blank -%}
                <div class="sec_subheading">{{ section.settings.subheading1 }}</div>
              {% endif %}
              {%- if section.settings.title != blank -%}
                <div class="sec_heading h2">{{ section.settings.title }}</div>
              {%- endif -%}
              {%- if section.settings.description != blank -%}
                <div class="sec_content">{{ section.settings.description }}</div>
              {% endif %}
             {%- if section.settings.content != blank -%}
                <div class="content_html">{{ section.settings.content }}</div>
              {% endif %}
              {% if section.settings.button != blank %}
                <a {% if section.settings.link %} href="{{ section.settings.link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="button slide-button 
                  {% if section.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}" aria-label="{{ section.settings.button }}">
                  {{ section.settings.button }}
                </a>
              {% endif %}
            </div>
          {% endif %}
         
            <div class="accordion-home">
               {%- for block in section.blocks -%}
                <div class="accordion-item details-{{ block.id }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
                  <div class="accordion-content">
                    <div class="h3">
                      {{ block.settings.heading | default: block.settings.page.title }}
                    </div>
                    <div class="collapsi-icon">
                      {{- 'icon-plus.svg' | inline_asset_content -}}
                    </div>
                  </div>
                
                  <div class="accordion__content-home rte paragraph">
                    {{ block.settings.row_content }}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          
        </div>
      </div>
    </div>
  </div>
</div>
                  
{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
@media screen and (max-width: 991px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
  }
}
@media screen and (max-width: 767px) {
  .section-{{ section.id }}-padding {
    padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
    padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
  }
}
{% endstyle %}

{% schema %}
  {
    "name": "Collapsible section",
    "tag": "section",
    "class": "section home_collapsible",
    "settings": [
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width",
        "default": false
      },
      {
        "type": "header",
        "content": "Image column setting"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Collapsible image"
      },
      {
        "type": "range",
        "id": "height_ratio",
        "min": 20,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Image height ratio",
        "default": 138
      },
      {
        "type": "header",
        "content": "t:sections.featured-collection.settings.header_text.content"
      },
      {
        "type": "text",
        "id": "subheading1",
        "label": "Subheading",
        "default": "Subheading"
      },
      {
        "type": "textarea",
        "id": "title",
        "default": "Heading",
        "label": "t:sections.featured-collection.settings.title.label"
      },
      {
        "type": "richtext",
        "id": "description",
        "default": "<p>Pair text with an image to focus on your chosen product.</p>",
        "label": "Content"
      },
      {
        "type": "richtext",
        "id": "content",
        "default": "<p>Pair text with an image to focus on your chosen product.</p>",
        "label": "Custom content"
      },
      {
        "type": "header",
        "content": "Button settings"
      },
      {
        "type": "text",
        "id": "button",
        "label": "Button",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Button link"
      },
      {
        "type": "checkbox",
        "id": "button_style_secondary_1",
        "default": false,
        "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Top bottom padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "collapsible",
        "name": "Collapsible",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "default": "Collapsible row",
            "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.heading.label"
          },
          {
            "type": "richtext",
            "id": "row_content",
            "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.row_content.label",
            "default": "<p>Pair text with an image to focus on your chosen product<p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collapsible section",
        "category": "Collapsible section",
        "blocks": [
          {
            "type": "collapsible"
          },
          {
            "type": "collapsible"
          },
          {
            "type": "collapsible"
          }
        ]
      }
    ]
  }
{% endschema %}