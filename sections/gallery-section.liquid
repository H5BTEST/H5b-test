<div class="gallery-section collection section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient" data-gallery-style="{{ section.settings.gallery_style }}">
  {% if section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
    <div class="page-width">
      <div class="gallery_title_wrap title-bottom-space {{ section.settings.text_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% else %}animate ad-2 show_up{% endif %}">
        {% if section.settings.main_subheading != blank %}<div class="sec_subheading">{{ section.settings.main_subheading }}</div>{% endif %}
        {% if section.settings.main_heading != blank %}<div class="sec_heading h2">{{ section.settings.main_heading }}</div>{% endif %}
        {% if section.settings.main_paragraph != blank %}<div class="sec_content">{{ section.settings.main_paragraph }}</div>{% endif %}
      </div>
    </div>
  {% endif %}
  <div class="{% if section.settings.full_width == false %}page-width{% else %}section-full-width{% endif %}">
    <div class="gallery-slider p-relative">
      <div class="gallery-wrapper">
        {%- for i in (0..1) -%}
        {% for block in section.blocks %}
          <div class="gallery-block">
            <div class="gallery_img {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% else %}animate ad-2{% endif %}">
              {% if block.settings.gallery-post-img != blank %}
                <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height-ratio }}%">
                  {{ block.settings.gallery-post-img | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
                </div>
              {% else %}
                <div class="media media--transparent ratio" style="--ratio-percent: {{ block.settings.height-ratio }}%">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                </div>
              {% endif %}
             </div>
          </div>
        {% endfor %}
        {% endfor %}
      </div>
    </div>
    
  </div>
</div>

{% style %}
  {% if section.settings.gallery_style == 'auto' %}
    .gallery-section .gallery-wrapper{
      animation: right-left {{ section.settings.speed }}s infinite linear;
    }
  {% endif %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.67 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.67 | round: 0 }}px, 15px);
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: max({{ section.settings.padding_top | times: 0.33 | round: 0 }}px, 15px);
      padding-bottom: max({{ section.settings.padding_bottom | times: 0.33 | round: 0 }}px, 15px);
    }
  }
{% endstyle %}

{% schema %}
  {
  "name": "Gallery section",
  "tag": "section",
  "class": "section gallery_section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_text.content"
    }, 
    {
      "type": "text",
      "id": "main_subheading",
      "label": "Subheading",
      "default": "Images"
    },
    {
      "type": "textarea",
      "id": "main_heading",
      "label": "Heading",
      "default": "Our Gallery"
    },
    {
      "type": "richtext",
      "id": "main_paragraph",
      "label": "Content",
      "default": "<p>Pair text with an image to focus on your chosen product.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Scroll type",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "on-scroll",
          "label": "On scroll"
        }
      ],
      "default": "on-scroll"
    },
    {
      "type": "header",
      "content": "Auto scroll settings"
    },
    {
      "type": "number",
      "id": "speed",
      "label": "Scroll speed",
      "default": 40
    },
    {
      "type": "header",
      "content": "Color settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Top bottom padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "gallery",
      "name": "Gallery post",
      "settings": [
        {
          "type": "image_picker",
          "id": "gallery-post-img",
          "label": "Gallery post"
        },
        {
          "type": "range",
          "id": "height-ratio",
          "min": 20,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Image height ratio",
          "default": 100
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery section",
      "blocks": [
        {
          "type": "gallery"
        },
        {
          "type": "gallery"
        },
        {
          "type": "gallery"
        },
        {
          "type": "gallery"
        },
        {
          "type": "gallery"
        },
        {
          "type": "gallery"
        }
      ]
    }
  ]
}
{% endschema %}